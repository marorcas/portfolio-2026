---
import BaseLayout from "../layouts/BaseLayout.astro";
import { journalEntries } from "../data/journal-entries";
---
<BaseLayout>
  <div class="page-header">
    <h1>GET /journal</h1>
    <p class="page-subtitle">200 OK · {journalEntries.length} entries</p>
  </div>
  <section class="items">
    {journalEntries.map((entry) => (
      <div class="item">
        <div class="item-header">
          <span class="entry-date">[{entry.date}]</span>
          <h2 class="item-title">{entry.title}</h2>
        </div>
        <p class="item-meta">Content: {entry.content}</p>
      </div>
          ))}
  </section>
</BaseLayout>